<h1>Usuarios</h1>

<%= link_to "+ Nuevo usuario", new_admin_user_path, class: "btn" %>

<table>
  <thead>
    <tr>
      <th>Usuario</th>
      <th>Admin</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.user %></td>
        <td><%= user.admin? ? "Sí" : "No" %></td>
        <td>
          <%= link_to "Editar", edit_admin_user_path(user), class: "btn" %>
          <%= link_to "Eliminar", admin_user_path(user), data: { turbo_method: :delete, turbo_confirm: "¿Seguro?" }, class: "btn btn-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>