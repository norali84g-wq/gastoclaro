<h1>Categorías</h1>
<div class="top-actions"><%= link_to "+ Nueva categoría", new_admin_category_path, class: "btn" %></div>

<style>
  .cat-list { font-family: Arial, sans-serif; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,0.04); }
  .cat-header-row { display: flex; align-items: center; background: #cfe3dd; color: #1f3a30; padding: 10px 16px; font-size: 12px; text-transform: uppercase; font-weight: bold; }
  .cat-header-row .cat-name-col { flex: 1; }
  .cat-row { display: flex; align-items: center; padding: 12px 16px; border-bottom: 1px solid #e1e6e4; }
  .cat-row .cat-name-col { flex: 1; }
  .cat-row.sub { padding-left: 48px; background: #fafbfa; }
  .cat-actions { display: flex; gap: 8px; }
  details.cat-group { border-bottom: 1px solid #e1e6e4; }
  details.cat-group summary { list-style: none; cursor: pointer; }
  details.cat-group summary::-webkit-details-marker { display: none; }
  details.cat-group summary .cat-row { border-bottom: none; }
  details.cat-group summary .cat-row .cat-name-col::before { content: "▸ "; color: #6b7a75; }
  details.cat-group[open] summary .cat-row .cat-name-col::before { content: "▾ "; }
</style>

<div class="cat-list">
  <div class="cat-header-row"><div class="cat-name-col">Nombre</div><div class="cat-actions"></div></div>

  <% @categories.each do |category| %>
    <% subcategorias = category.subcategories.sort_by(&:name) %>

    <% if subcategorias.any? %>
      <details class="cat-group">
        <summary>
          <div class="cat-row">
            <div class="cat-name-col"><%= link_to category.name, admin_category_path(category) %></div>
            <div class="cat-actions">
              <%= link_to "Editar", edit_admin_category_path(category, return_to: request.fullpath), class: "btn secondary" %>
              <%= button_to "Eliminar", admin_category_path(category), method: :delete, params: { return_to: request.fullpath }, class: "btn danger", form: { data: { turbo_confirm: "¿Eliminar categoría?" }, style: "display:inline" } %>
            </div>
          </div>
        </summary>

        <% subcategorias.each do |sub| %>
          <div class="cat-row sub">
            <div class="cat-name-col">↳ <%= link_to sub.name, admin_category_path(sub) %></div>
            <div class="cat-actions">
              <%= link_to "Editar", edit_admin_category_path(sub, return_to: request.fullpath), class: "btn secondary" %>
              <%= button_to "Eliminar", admin_category_path(sub), method: :delete, params: { return_to: request.fullpath }, class: "btn danger", form: { data: { turbo_confirm: "¿Eliminar categoría?" }, style: "display:inline" } %>
            </div>
          </div>
        <% end %>
      </details>
    <% else %>
      <div class="cat-row">
        <div class="cat-name-col"><%= link_to category.name, admin_category_path(category) %></div>
        <div class="cat-actions">
          <%= link_to "Editar", edit_admin_category_path(category, return_to: request.fullpath), class: "btn secondary" %>
          <%= button_to "Eliminar", admin_category_path(category), method: :delete, params: { return_to: request.fullpath }, class: "btn danger", form: { data: { turbo_confirm: "¿Eliminar categoría?" }, style: "display:inline" } %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
